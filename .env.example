# --- Application ---
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=content_platform
MYSQL_USER=app
MYSQL_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Never unbounded: an open wait turns one slow query into a total stall.
DB_POOL_TIMEOUT=10.0
# Under MySQL's wait_timeout (28800s) and under a typical proxy idle timeout.
DB_POOL_RECYCLE=1800

# --- Redis ---
# Auth (if any) goes inside the URL: redis://:password@host:6379/0
REDIS_URL=redis://localhost:6379/0
# Bounded on purpose: the library default is unbounded, which turns a blackholed Redis into an
# indefinite wait for every caller.
REDIS_SOCKET_TIMEOUT=2.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
# Pool ceiling: redis-py grows its pool without limit.
REDIS_MAX_CONNECTIONS=50

# --- Cache (cache-aside) ---
# false bypasses Redis completely: no connection, no keys, every read goes to MySQL.
CACHE_ENABLED=true
CACHE_ARTICLE_TTL_SECONDS=300
CACHE_LIST_TTL_SECONDS=60
# Spread TTLs over base +/- base * jitter, so a generation of keys does not expire at once.
CACHE_TTL_JITTER=0.2
# How long a single-flight lock is held, and how long a loser waits before reading MySQL itself.
CACHE_LOCK_TIMEOUT_SECONDS=2.0

# --- Resilience ---
# Ceilings at both ends of every dependency call. `app/resilience/policy.py` refuses an
# unbounded or self-contradictory set at start-up. See ADR-0012.
# aiomysql opens a socket with no connect timeout, so a blackholed host holds the request until
# the kernel gives up.
DB_CONNECT_TIMEOUT_SECONDS=5.0
# The server-side kill, sent as max_execution_time on every connection.
DB_STATEMENT_TIMEOUT_SECONDS=2.0
# The whole guarded call, retries included. Must exceed DB_STATEMENT_TIMEOUT_SECONDS.
DB_CALL_TIMEOUT_SECONDS=3.0
# Attempts, not retries: 2 means one retry. Reads only; writes are never retried.
DB_RETRY_ATTEMPTS=2
# Full jitter between attempts: each wait is drawn from [0, min(base * 2**n, max)].
RETRY_BACKOFF_BASE_SECONDS=0.05
RETRY_BACKOFF_MAX_SECONDS=0.5
# Consecutive failures that open the circuit, and how long it fails fast before it probes.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=10.0
# More than one probe turns a recovery into a thundering herd.
BREAKER_HALF_OPEN_MAX_CALLS=1

# --- Auth (JWT) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=900

# --- Observability ---
# Leave empty to disable tracing entirely (no provider, no exporter, no outbound connections).
# With the observability compose profile: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=scalable-content-platform
