# --- Application ---
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=content_platform
MYSQL_USER=app
MYSQL_PASSWORD=
DB_POOL_SIZE=10

# --- Redis ---
# Auth (if any) goes inside the URL: redis://:password@host:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=900

# --- Observability ---
# Leave empty to disable tracing entirely (no provider, no exporter, no outbound connections).
# With the observability compose profile: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=scalable-content-platform
