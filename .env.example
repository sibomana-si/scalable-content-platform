# --- Application ---
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=content_platform
MYSQL_USER=app
MYSQL_PASSWORD=
DB_POOL_SIZE=10

# --- Redis ---
# Auth (if any) goes inside the URL: redis://:password@host:6379/0
REDIS_URL=redis://localhost:6379/0
# Bounded on purpose: the library default is unbounded, which turns a blackholed Redis into an
# indefinite wait for every caller.
REDIS_SOCKET_TIMEOUT=2.0
REDIS_SOCKET_CONNECT_TIMEOUT=2.0

# --- Cache (cache-aside) ---
# false bypasses Redis completely: no connection, no keys, every read goes to MySQL.
CACHE_ENABLED=true
CACHE_ARTICLE_TTL_SECONDS=300
CACHE_LIST_TTL_SECONDS=60
# Spread TTLs over base +/- base * jitter, so a generation of keys does not expire at once.
CACHE_TTL_JITTER=0.2
# How long a single-flight lock is held, and how long a loser waits before reading MySQL itself.
CACHE_LOCK_TIMEOUT_SECONDS=2.0

# --- Auth (JWT) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=900

# --- Observability ---
# Leave empty to disable tracing entirely (no provider, no exporter, no outbound connections).
# With the observability compose profile: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=scalable-content-platform
