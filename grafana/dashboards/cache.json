{
  "uid": "scp-cache",
  "title": "Cache (Redis)",
  "description": "Redis cache-aside effectiveness and degradation. The hit ratio answers whether the cache is doing its job; cache_errors_total answers whether it is failing open. Read the two together: a falling hit ratio with a flat error rate is a workload change, and a falling hit ratio with a climbing error rate is a Redis problem.",
  "tags": [
    "scalable-content-platform",
    "cache"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hit ratio (5m)",
      "description": "Target >= 90%. The capacity model prices MySQL at ~55 qps on this number; uncached the same traffic is ~500 qps.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(cache_hits_total[5m])) or vector(0))\n/ clamp_min(sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])), 0.0001)",
          "legendFormat": "hit ratio",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Degraded operations (5m)",
      "description": "Cache commands that failed and were degraded around. Any sustained value means requests are paying a Redis timeout before falling back to MySQL.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_errors_total[5m])) or vector(0)",
          "legendFormat": "errors/s",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hit ratio by entity",
      "description": "Article detail carries the hit-ratio target. Unfiltered list pages bust on every write by design (generation counter), so a low list ratio under a write-heavy load is expected, not a fault.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(cache_hits_total{entity=\"article\"}[5m])) or vector(0))\n/ clamp_min(sum(rate(cache_hits_total{entity=\"article\"}[5m])) + sum(rate(cache_misses_total{entity=\"article\"}[5m])), 0.0001)",
          "legendFormat": "article",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "(sum(rate(cache_hits_total{entity=\"list\"}[5m])) or vector(0))\n/ clamp_min(sum(rate(cache_hits_total{entity=\"list\"}[5m])) + sum(rate(cache_misses_total{entity=\"list\"}[5m])), 0.0001)",
          "legendFormat": "list",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Hits and misses by entity",
      "description": "The raw read volume behind the ratio. A ratio alone hides a collapse in traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (entity) (rate(cache_hits_total[5m]))",
          "legendFormat": "hit \u2014 {{entity}}",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (entity) (rate(cache_misses_total[5m]))",
          "legendFormat": "miss \u2014 {{entity}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Degraded operations by type",
      "description": "Which cache call is failing. One failure latches the rest of that request's cache work off, so this counts requests that degraded, not commands attempted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(cache_errors_total[5m]))",
          "legendFormat": "{{operation}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Database read rate (cache effect)",
      "description": "SELECT rate against the API request rate. This is the load the cache removes from MySQL, and the number the M6 load test compares before and after.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(db_query_duration_seconds_count{query=\"select\"}[5m]))",
          "legendFormat": "SELECT/s",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_requests_total[5m]))",
          "legendFormat": "requests/s",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        }
      }
    }
  ]
}
